# === Optional AI API Keys ===
# Claude API (Anthropic) — optional conversation/planning assistant
ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek API — optional assistant and knowledge crawler
DEEPSEEK_API_KEY=sk-...

# The local profile, resource, comparison, journal, and simulation tools work
# without either key.

# === Optional ===
# Bing Search API — 爬虫搜索引擎
# BING_API_KEY=

# === App Config ===
NEXT_PUBLIC_APP_NAME=Career Maze

# API 鉴权令牌 — 设置后所有 /api 写接口要求 `Authorization: Bearer <token>`
# 本地开发可留空（留空时跳过鉴权）
# API_AUTH_TOKEN=change-me-to-a-long-random-string

# === AI API Keys ===
# Claude API (Anthropic) — 主要 AI 引擎
ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek API — 知识库爬虫使用
DEEPSEEK_API_KEY=sk-...

# === Optional ===
# Bing Search API — 爬虫搜索引擎
# BING_API_KEY=

# === App Config ===
NEXT_PUBLIC_APP_NAME=Career Maze

# API 鉴权令牌 — 设置后所有 /api 写接口要求 `Authorization: Bearer <token>`
# 本地开发可留空（留空时跳过鉴权）
# API_AUTH_TOKEN=change-me-to-a-long-random-string
